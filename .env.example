# ── Omni · نمونهٔ متغیرهای محیطی ────────────────────────────────
# این فایل امن است و مقدار واقعی ندارد. مقادیر را در Cloudflare Secret بگذار.

# توکن API کلادفلر (Workers + D1 + KV)
CLOUDFLARE_API_TOKEN=

# شناسهٔ حساب کلادفلر
CLOUDFLARE_ACCOUNT_ID=

# توکن ربات تلگرام (اختیاری)
BOT_TOKEN=

# نام کاربری ربات (بدون @)
BOT_USERNAME=

# رشتهٔ امضای وبهوک — تصادفی و طولانی
BOT_WEBHOOK_SECRET=

# نام نمایشی پنل
PANEL_NAME=Omni

# دامنهٔ عمومی پنل
PUBLIC_HOST=
