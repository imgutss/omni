{
  "name": "omni",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Omni — پنل مدیریت پروکسی VLESS روی Cloudflare Workers (بدون سرور، رایگان، با ربات تلگرام)",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "deploy:auto": "node deploy/deploy.mjs",
    "push:github": "node deploy/github.mjs",
    "test": "bash test/run-e2e.sh",
    "pool": "node tools/pool-scan.mjs",
    "verify": "node tools/sub-verify.mjs",
    "tail": "wrangler tail",
    "build:production": "node production/build.mjs",
    "predeploy": "npm run build:production",
    "predeploy:auto": "npm run build:production",
    "test:scanner": "npm --prefix production test",
    "test:scanner:browser": "npm --prefix production run test:browser"
  },
  "devDependencies": {
    "wrangler": "^3.80.0",
    "ws": "^8.18.0"
  }
}
